<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_print_iban" model="ir.ui.view">
        <field name="name">account.move.form.inherit.print.iban</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Añadir campo después del método de pago preferido -->
            <xpath expr="//field[@name='preferred_payment_method_line_id']" position="after">
                <field name="print_customer_iban" readonly="1" 
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
