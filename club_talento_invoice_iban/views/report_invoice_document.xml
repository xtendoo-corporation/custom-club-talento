<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <!-- Agregar IBAN del cliente en la misma línea que el total -->
        <xpath expr="//div[@id='right-elements']" position="before">
            <div class="col-6 d-inline-block float-start mt-5" t-if="o.move_type == 'out_invoice' and o.print_customer_iban and o.partner_id.bank_ids">
                <t t-set="partner_bank" t-value="o.partner_id.bank_ids[:1]"/>
                <t t-if="partner_bank and partner_bank.acc_number">
                    <strong>Cuenta bancaria para domiciliación:</strong><br/>
                    <span t-esc="partner_bank.acc_number"/>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
