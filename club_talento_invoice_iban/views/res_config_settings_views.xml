<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_invoice_iban" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.invoice.iban</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pay_invoice_online_setting_container']" position="after">
                <block title="IBAN en Factura PDF" id="invoice_iban_setting_container">
                    <setting
                        id="invoice_iban_payment_methods"
                        string="Mostrar IBAN del cliente en factura"
                        company_dependent="1"
                        help="Seleccione los métodos de pago para los cuales se mostrará el IBAN del cliente en el PDF de la factura">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="invoice_iban_payment_method_line_ids" class="col-lg-4 o_light_label" string="Métodos de pago"/>
                                <field name="invoice_iban_payment_method_line_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <div class="text-muted mt8">
                                Si la factura de cliente tiene uno de estos métodos de pago,
                                se imprimirá el IBAN del cliente en el PDF.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
