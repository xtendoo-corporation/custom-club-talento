<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista formulario del wizard -->
    <record id="view_club_talento_import_wizard_form" model="ir.ui.view">
        <field name="name">club.talento.import.wizard.form</field>
        <field name="model">club.talento.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Asientos Club Talento">
                <sheet>
                    <group>
                        <group name="file_group" string="Archivo">
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>

                        <group name="config_group" string="Configuración">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group name="options_group" string="Opciones">
                            <field name="create_accounts"/>
                            <field name="create_partners"/>
                            <field name="post_balanced"/>
                        </group>
                    </group>

                    <group name="result_group" string="Resultado" invisible="state != 'done'">
                        <field name="result_text" nolabel="1" readonly="1"
                               widget="text"
                               style="font-family: monospace; white-space: pre;"/>
                    </group>

                    <field name="state" invisible="1"/>
                    <field name="move_ids" invisible="1"/>
                </sheet>

                <footer>
                    <button name="action_import"
                            string="Importar"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Cerrar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del wizard -->
    <record id="action_club_talento_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Asientos desde Excel</field>
        <field name="res_model">club.talento.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>

</odoo>

